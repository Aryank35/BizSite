# ─── Database ────────────────────────────────────────────────────────────────
# Any PostgreSQL 14+ server. `npm run db:dev` starts a local one on port 5544.
DATABASE_URL="postgresql://postgres:postgres@localhost:5544/bizsite"
# Used only by `npm run test:integration` (it is migrated and wiped by the tests).
TEST_DATABASE_URL="postgresql://postgres:postgres@localhost:5544/bizsite_test"

# ─── Application ────────────────────────────────────────────────────────────
# Public base URL of the app (no trailing slash).
APP_URL="http://localhost:3000"

# ─── Authentication (Better Auth) ───────────────────────────────────────────
# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# ─── File storage ───────────────────────────────────────────────────────────
# "local" stores uploads on disk (development / single server).
# "s3" uses any S3-compatible service (AWS S3, Cloudflare R2, MinIO, …).
STORAGE_DRIVER="local"
LOCAL_UPLOAD_DIR=".data/uploads"

# Required when STORAGE_DRIVER="s3"
S3_BUCKET=""
S3_REGION="auto"
S3_ENDPOINT=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Public base URL that serves objects from the bucket (CDN or bucket URL), no trailing slash.
S3_PUBLIC_URL=""

# ─── Optional: tenant subdomains ────────────────────────────────────────────
# When set (e.g. "bizsite.com"), requests to <slug>.bizsite.com are served the
# business website. Requires wildcard DNS — leave empty for slug routes (/site/<slug>).
TENANT_ROOT_DOMAIN=""

# ─── Development seed (never used in production) ────────────────────────────
SEED_SUPERADMIN_EMAIL="admin@bizsite.local"
SEED_SUPERADMIN_PASSWORD="ChangeMe!Admin2026"
SEED_BUSINESS_ADMIN_PASSWORD="ChangeMe!Business2026"
